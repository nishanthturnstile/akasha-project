# Akasha local Docker Compose placeholders.
# Copy to .env for local development and replace CHANGE_ME values before starting.

WEB_PORT=8080
PUBLIC_APP_NAME=Akasha
PUBLIC_DEFAULT_AOI_NAME=Bangalore

POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=akasha

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# API Sentinel-1 VV grayscale dB display stretch.
AKASHA_S1_VV_RESCALE=-25,5

# Sentinel-1 SAR preprocessing runtime knobs. These are not secrets.
# The SAR prep service reuses AKASHA_S1_VV_RESCALE above for VV manifest defaults.
SNAP_CACHE_SIZE=8G
SNAP_PARALLELISM=4
SNAP_JAVA_MAX_HEAP=12g
AKASHA_S1_DEM_SOURCE=Copernicus 30m Global DEM
AKASHA_S1_FALLBACK_DEM_SOURCE=SRTM 1Sec HGT
AKASHA_S1_TARGET_CRS=EPSG:4326
AKASHA_S1_PIXEL_SPACING_METERS=10
AKASHA_S1_VH_RESCALE=-30,-5