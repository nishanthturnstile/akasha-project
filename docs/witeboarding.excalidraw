      "fontSize": 13,
      "fontFamily": 6,
      "text": "TITILER — RASTER TILE SERVER\nReads Cloud-Optimized GeoTIFFs from disk and renders map tiles on demand.\nProvides: instant satellite imagery (true-color, NDVI, NDWI, SAR) — no pre-rendering needed.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ZzXtOFBxfW5-y-D3O6ugt",
      "originalText": "TITILER — RASTER TILE SERVER\nReads Cloud-Optimized GeoTIFFs from disk and renders map tiles on demand.\nProvides: instant satellite imagery (true-color, NDVI, NDWI, SAR) — no pre-rendering needed.",
      "lineHeight": 1.35,
      "index": "b07",
      "autoResize": true
    },
