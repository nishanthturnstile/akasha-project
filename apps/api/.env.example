# Akasha FastAPI BFF — Railway / Docker environment placeholders.
# Copy values into Railway variables or a local .env file; never commit real secrets.

APP_ENV=production
PORT=8000

# Internal services (Railway private networking in production).
DATABASE_URL=postgresql://<user>:<password>@postgis.railway.internal:5432/<db>
STAC_API_URL=http://stac-api.railway.internal:8080
TITILER_URL=http://titiler.railway.internal:8000
S3_ENDPOINT_URL=http://minio.railway.internal:9000

# Slice 2: server-side S3/GDAL access for rasterio masked statistics.
# Keep these server-only; never expose credentials to the browser/frontend.
AWS_ACCESS_KEY_ID=<minio-access-key>
AWS_SECRET_ACCESS_KEY=<minio-secret-key>
AWS_S3_ENDPOINT=minio.railway.internal:9000
AWS_VIRTUAL_HOSTING=FALSE
AWS_HTTPS=NO
AWS_REGION=us-east-1
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff
AKASHA_RGB_RESCALE=0,3000

# Default catalog/AOI choices.
DEFAULT_SOURCE_ID=sentinel-2-l2a
DEFAULT_AOI_ID=bangalore

# Guardrails used by later slices.
USABLE_PIXEL_THRESHOLD_PERCENT=70
MAX_POLYGON_AREA_HA=50
MAX_POLYGON_VERTICES=5000
INDEX_REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_INDEX_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=1048576

# Comma-separated public origins allowed to call the BFF.
CORS_ALLOWED_ORIGINS=https://<web-public-domain>