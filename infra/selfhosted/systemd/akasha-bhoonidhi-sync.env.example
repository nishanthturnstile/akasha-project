# Copy to /etc/akasha/bhoonidhi-sync.env on the staging worker VM.
# Keep this file root-readable only if it includes Bhoonidhi credentials.

# Optional. If unset, the wrapper uses /srv/akasha/coolify-compose.yml when
# present, otherwise the first Coolify-rendered /data/coolify/services/* compose.
# AKASHA_COMPOSE_FILE=/data/coolify/services/<resource-uuid>/docker-compose.yml
# Optional. Leave unset for Coolify-rendered compose files so Docker Compose uses
# the project name from the compose directory.
# AKASHA_COMPOSE_PROJECT=<compose-project>
AKASHA_SYNC_PULL_POLICY=never

AKASHA_SYNC_SOURCE=resourcesat-2a-liss3-boa
AKASHA_SYNC_AOI=bangalore-60km
AKASHA_SYNC_LOOKBACK_DAYS=45
AKASHA_SYNC_WINDOW_DAYS=45
AKASHA_SYNC_LIMIT=100
AKASHA_SYNC_MAX_DOWNLOADS=3
AKASHA_SYNC_MIN_COVERAGE_PERCENT=95

# Set BACKFILL_DAYS during launch to spread historical processing across timer
# runs. STEP_DAYS controls overlap between composite windows.
# AKASHA_SYNC_BACKFILL_DAYS=90
# AKASHA_SYNC_BACKFILL_STEP_DAYS=15
# AKASHA_SYNC_BACKFILL_STATE_PATH=/srv/akasha/ingestion/bhoonidhi-backfill-state.json

AKASHA_SYNC_RAW_ROOT=/srv/akasha/data/raw/bhoonidhi
AKASHA_SYNC_TEMP_ROOT=/srv/akasha/data/work/bhoonidhi
AKASHA_SYNC_LEDGER_PATH=/srv/akasha/ingestion/ledger.sqlite
AKASHA_SYNC_WORKER_LOCK_PATH=/srv/akasha/ingestion/bhoonidhi-sync.worker.lock

# Optional:
# AKASHA_SYNC_AOI_PATH=/srv/akasha/data/seed/bangalore-60km-aoi.geojson
# AKASHA_SYNC_AOI_DIR=/srv/akasha/data/seed/aois
# AKASHA_SYNC_WINDOW_START=2026-03-01
# AKASHA_SYNC_WINDOW_END=2026-03-31
# AKASHA_SYNC_BACKFILL_ANCHOR_DATE=2026-06-16
# AKASHA_SYNC_RETAIN_RAW_DOWNLOADS=true
# AKASHA_SYNC_KEEP_INTERMEDIATE=true
# AKASHA_SYNC_FORCE_UPLOAD=true
# AKASHA_SYNC_OVERWRITE=true
# AKASHA_SYNC_DRY_RUN=true
