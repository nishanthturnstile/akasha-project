    { "name": "Bhoonidhi", "roles": ["host"], "url": "https://bhoonidhi.nrsc.gov.in" },
    { "name": "Akasha", "roles": ["processor"] }
  ],
  "extent": {
    "spatial": { "bbox": [[77.023647, 12.537266, 78.131561, 13.61645]] },
    "temporal": { "interval": [["2026-03-19T00:00:00Z", null]] }
  },
  "summaries": {
    "platform": ["resourcesat-2a"],
    "constellation": ["resourcesat"],
    "instruments": ["liss-4"],
    "gsd": [5.8],
    "proj:epsg": [32643]
  },
