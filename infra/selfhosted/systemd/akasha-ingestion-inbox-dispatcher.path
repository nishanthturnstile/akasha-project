[Unit]
Description=Watch Akasha ingestion inbox for admin trigger requests
Documentation=https://github.com/nishanthturnstile/akasha-project/blob/main/docs/impl-plan/feature-admin-ingestion-trigger-1.md

[Path]
PathExistsGlob=/srv/akasha/ingestion-inbox/*/request.json
Unit=akasha-ingestion-inbox-dispatcher.service

[Install]
WantedBy=multi-user.target
