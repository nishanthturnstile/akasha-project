  "akasha:mask_method": "Akasha threshold mask v1 (LISS-4, no SWIR; provisional)",
  "akasha:metrics_provisional": true,
  "akasha:refresh_policy": "Bhoonidhi search on the ~5-day LISS-4 MX revisit cadence; L2 products may lag acquisition.",
  "akasha:reflectance": {
