# Akasha FastAPI BFF — deployment / Docker environment placeholders.
# Copy values into your deployment environment or a local .env file; never commit real secrets.

APP_ENV=production
PORT=8000

# Internal services (Docker/Coolify private networking in production).
DATABASE_URL=postgresql://<user>:<password>@postgis:5432/<db>
STAC_API_URL=http://stac-api:8080
TITILER_URL=http://titiler:8000
S3_ENDPOINT_URL=http://minio:9000
AKASHA_COG_BUCKET=akasha-cogs

# Slice 2: server-side S3/GDAL access for rasterio masked statistics.
# Keep these server-only; never expose credentials to the browser/frontend.
AWS_ACCESS_KEY_ID=<minio-access-key>
AWS_SECRET_ACCESS_KEY=<minio-secret-key>
AWS_S3_ENDPOINT=minio:9000
AWS_VIRTUAL_HOSTING=FALSE
AWS_HTTPS=NO
AWS_REGION=us-east-1
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff
AKASHA_RGB_RESCALE=0,3000
AKASHA_S1_VV_RESCALE=-25,5

# Default catalog/AOI choices.
DEFAULT_SOURCE_ID=resourcesat-2a-liss3-boa
# Optional multi-AOI selector. Leave blank to use AOI_CONFIG_PATH as the default AOI.
DEFAULT_AOI_ID=
AOI_CONFIG_PATH=data/seed/bangalore-60km-aoi.geojson
BASEMAP_PROVIDER=esri
ESRI_BASEMAP_STYLE=arcgis/imagery
ESRI_BASEMAP_STYLE_FAMILY=arcgis
ESRI_BASEMAP_USAGE_MODEL=session
ESRI_BASEMAP_PLACES=none
ESRI_BASEMAP_SESSION_SECONDS=43200

# Guardrails used by later slices.
USABLE_PIXEL_THRESHOLD_PERCENT=70
MAX_POLYGON_AREA_HA=50
MAX_POLYGON_VERTICES=5000
INDEX_REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_INDEX_PER_MINUTE=30
SOURCE_FRESHNESS_STALE_DAYS=45
SOURCE_COVERAGE_THRESHOLD_PERCENT=95
MAX_REQUEST_BODY_BYTES=1048576

# Temporary staging-only Bhoonidhi diagnostics. Keep disabled unless testing
# from the whitelisted staging VM. Do not expose these values to the browser.
BHOONIDHI_DIAGNOSTICS_ENABLED=false
BHOONIDHI_USER_ID=<bhoonidhi-user-id>
BHOONIDHI_PASSWORD=<bhoonidhi-password>
BHOONIDHI_API_BASE=https://bhoonidhi-api.nrsc.gov.in
BHOONIDHI_DOWNLOAD_ROOT=/srv/akasha/bhoonidhi-diagnostics
BHOONIDHI_DOWNLOAD_TIMEOUT_SECONDS=300
BHOONIDHI_MAX_DOWNLOAD_BYTES=5368709120
BHOONIDHI_LEDGER_PATH=/srv/akasha/ingestion/ledger.sqlite

# Comma-separated public origins allowed to call the BFF.
CORS_ALLOWED_ORIGINS=https://<web-public-domain>

# Authentication. AUTH_MODE=disabled is local/dev/test only; hosted/customer
# deployments must use enabled mode and set a strong pepper. Disabled mode also
# requires AUTH_ALLOW_DISABLED=true, which should only be used locally.
AUTH_MODE=enabled
AUTH_ALLOW_DISABLED=false
AUTH_SESSION_COOKIE_NAME=akasha_session
AUTH_SESSION_TTL_MINUTES=480
AUTH_REMEMBER_TTL_DAYS=30
AUTH_PASSWORD_PEPPER=<generated-secret>
AUTH_ALLOW_SIGNUP=false
AUTH_COOKIE_SECURE=true
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_SIGNUP_RATE_LIMIT_PER_HOUR=20
