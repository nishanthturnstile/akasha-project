  "id": "sentinel-2-l2a",
  "title": "Sentinel-2 L2A (Akasha Wave 1)",
  "description": "Sentinel-2 Level-2A surface reflectance over the Bangalore AOI. Wave 1 stores raw uint16 DN COGs (no pre-stretch); per-band scale/offset is applied downstream. Analytic reflectance and SCL are separate COG assets. True-colour RGB uses analytic bands [1, 8, 9] = (B04 Red, B03 Green, B02 Blue).",
  "license": "proprietary",
  "keywords": ["sentinel-2", "l2a", "surface-reflectance", "ndvi", "bangalore"],
  "providers": [
    { "name": "ESA / Copernicus", "roles": ["producer", "licensor"], "url": "https://sentinel.esa.int" },
    { "name": "Copernicus Data Space Ecosystem", "roles": ["processor", "host"], "url": "https://dataspace.copernicus.eu" },
    { "name": "Akasha", "roles": ["processor"] }
  ],
  "extent": {
    "spatial": { "bbox": [[77.4, 12.8, 77.8, 13.2]] },
    "temporal": { "interval": [["2015-06-23T00:00:00Z", null]] }
  },
  "summaries": {
    "platform": ["sentinel-2a", "sentinel-2b"],
    "constellation": ["sentinel-2"],
    "instruments": ["msi"],
    "gsd": [10],
    "proj:epsg": [32643]
  },
  "akasha:supported_indices": ["NDVI", "NDRE", "NDMI", "NDWI_GREEN_NIR"],
  "akasha:default_index": "NDVI",
  "akasha:rgb_band_positions": [1, 8, 9],
  "akasha:default_excluded_scl_classes": [0, 1, 2, 3, 7, 8, 9, 10, 11],
  "akasha:reflectance": {
    "quantification_value": 10000,
    "boa_add_offset_dn": -1000,
    "scale": 0.0001,
    "offset": -0.1,
    "note": "raw DN stored; corrected_reflectance = (dn + boa_add_offset_dn) / quantification_value. STAC offset is -0.1 (NOT -1000)."
  },
  "item_assets": {
