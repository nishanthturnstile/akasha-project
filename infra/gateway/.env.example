# Akasha web gateway — the only public service.

PORT=80
PUBLIC_APP_NAME=Akasha
PUBLIC_DEFAULT_AOI_NAME=Bangalore

# Internal (private network) service URLs.
API_UPSTREAM_URL=http://api:8000
TITILER_UPSTREAM_URL=http://titiler:8000

# Build-time frontend basemap settings. Hosted gateway builds should use Esri unless
# intentionally deploying a non-ArcGIS development preview.
VITE_BASEMAP_PROVIDER=esri
VITE_ESRI_API_KEY=<referrer-restricted ArcGIS Location Platform key with Basemaps privilege>
VITE_ESRI_BASEMAP_STYLE=arcgis/imagery
VITE_ESRI_BASEMAP_STYLE_FAMILY=arcgis
VITE_ESRI_BASEMAP_PLACES=none
VITE_ESRI_BASEMAP_SESSION_SECONDS=43200

# Empty means off. For a public demo, replace with an edge/auth solution or bcrypt-backed Caddy basic_auth config.
GATEWAY_BASIC_AUTH=
