  "akasha:unsupported_indices": ["NDMI", "NDRE", "RECI"],
  "akasha:default_index": "NDVI",
  "akasha:display_modes": ["FCC", "NDVI", "MSAVI", "NDWI_GREEN_NIR"],
  "akasha:default_display_mode": "FCC",
  "akasha:map_display_modes": ["NDVI", "MSAVI", "NDWI_GREEN_NIR"],
  "akasha:default_map_display_mode": "NDVI",
  "akasha:tile_route_mode": "fcc",
  "akasha:fcc_role_order": ["NIR", "RED", "GREEN"],
  "akasha:band_role_mapping": {
    "GREEN": "BAND2",
    "RED": "BAND3",
