# Akasha local Docker Compose placeholders.
# Copy to .env for local development and replace CHANGE_ME values before starting.

WEB_PORT=8080
FRONTEND_PORT=5173
PUBLIC_APP_NAME=Akasha
PUBLIC_DEFAULT_AOI_NAME=Bangalore

POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=akasha

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# Frontend build-time basemap settings. Local development defaults to OSM to avoid
# consuming ArcGIS basemap sessions; set VITE_BASEMAP_PROVIDER=esri when validating
# the hosted ArcGIS basemap path.
VITE_BASEMAP_PROVIDER=osm
VITE_ESRI_API_KEY=CHANGE_ME_REFERRER_RESTRICTED_ESRI_KEY
VITE_ESRI_BASEMAP_STYLE=arcgis/imagery
VITE_ESRI_BASEMAP_STYLE_FAMILY=arcgis
VITE_ESRI_BASEMAP_PLACES=none
VITE_ESRI_BASEMAP_SESSION_SECONDS=43200

# Authentication (enforced). The pepper is a server-side secret mixed into
# every password hash — generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_PASSWORD_PEPPER=CHANGE_ME_AUTH_PASSWORD_PEPPER
# Local self-service sign-up for development/testing multiple users.
# Keep disabled in hosted/customer deployments unless intentionally opened.
AUTH_ALLOW_SIGNUP=true

# API Sentinel-1 VV grayscale dB display stretch.
AKASHA_S1_VV_RESCALE=-25,5

# Sentinel-1 SAR preprocessing runtime knobs. These are not secrets.
# The SAR prep service reuses AKASHA_S1_VV_RESCALE above for VV manifest defaults.
SNAP_CACHE_SIZE=8G
SNAP_PARALLELISM=4
SNAP_JAVA_MAX_HEAP=12g
AKASHA_S1_DEM_SOURCE=Copernicus 30m Global DEM
AKASHA_S1_FALLBACK_DEM_SOURCE=SRTM 1Sec HGT
AKASHA_S1_TARGET_CRS=EPSG:4326
AKASHA_S1_PIXEL_SPACING_METERS=10
AKASHA_S1_VH_RESCALE=-30,-5
