# Akasha self-hosted Coolify environment template.
#
# Copy these keys into the Coolify service stack environment for staging and
# production. Replace every CHANGE_ME value in Coolify only. Do not commit real
# secrets. Staging and production must use different secret values.

# ---------------------------------------------------------------------------
# Image selection
# ---------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=akasha-techcatalyst
# Required. Use the immutable Git SHA tag built by the client repository workflow.
IMAGE_TAG=CHANGE_ME_GIT_SHA

# ---------------------------------------------------------------------------
# Host persistence
# ---------------------------------------------------------------------------
# akasha-control app data root. Keep provider downloads, raster work dirs, and
# ingestion bulk data on the standalone akasha-staging ingestion VM.
APP_DATA_ROOT=/data/akasha

# ---------------------------------------------------------------------------
# Public web origin and product metadata
# ---------------------------------------------------------------------------
# Required. Exact browser origin for the web gateway. Examples:
#   https://staging.example.edu
#   http://20.219.3.35    # temporary HTTP rehearsal only
# Coolify uses SERVICE_FQDN_WEB to generate the public web router. Keep it
# identical to PUBLIC_ORIGIN unless intentionally rehearsing with a temporary URL.
SERVICE_FQDN_WEB=CHANGE_ME_PUBLIC_WEB_ORIGIN
PUBLIC_ORIGIN=CHANGE_ME_PUBLIC_WEB_ORIGIN
PUBLIC_APP_NAME=Akasha
PUBLIC_DEFAULT_AOI_NAME=Bangalore

# ---------------------------------------------------------------------------
# PostgreSQL / pgSTAC
# ---------------------------------------------------------------------------
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# URL-encoded form of POSTGRES_PASSWORD for DATABASE_URL.
# Example: p@ss/word -> p%40ss%2Fword
POSTGRES_PASSWORD_URLENCODED=CHANGE_ME_POSTGRES_PASSWORD_URLENCODED
POSTGRES_DB=akasha

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
AWS_REGION=us-east-1
AKASHA_COG_BUCKET=akasha-cogs

# ---------------------------------------------------------------------------
# API runtime and raster/index settings
# ---------------------------------------------------------------------------
APP_ENV=production
AKASHA_RGB_RESCALE=0,3000
AKASHA_S1_VV_RESCALE=-25,5
DEFAULT_SOURCE_ID=resourcesat-2a-liss3-boa
# Optional multi-AOI selector. Leave blank to use AOI_CONFIG_PATH as the default AOI.
DEFAULT_AOI_ID=
AOI_CONFIG_PATH=/app/data/seed/bangalore-60km-aoi.geojson
AOI_CONFIG_DIR=

# ArcGIS basemap metadata is returned by /api/config. Keep `session` while
# deploying/validating dual-mode code, then set only staging to `tile` after
# ArcGIS PAYG is explicitly enabled and session-mode compatibility smoke passes.
BASEMAP_PROVIDER=esri
ESRI_BASEMAP_STYLE=arcgis/imagery
ESRI_BASEMAP_STYLE_FAMILY=arcgis
ESRI_BASEMAP_USAGE_MODEL=session
ESRI_BASEMAP_PLACES=none
# Used only by session mode and retained for configuration-only rollback.
ESRI_BASEMAP_SESSION_SECONDS=43200

USABLE_PIXEL_THRESHOLD_PERCENT=70
MAX_POLYGON_AREA_HA=50
MAX_POLYGON_VERTICES=5000
INDEX_REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_INDEX_PER_MINUTE=30
SOURCE_FRESHNESS_STALE_DAYS=45
SOURCE_COVERAGE_THRESHOLD_PERCENT=95
MAX_REQUEST_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Standalone ingestion analytics bridge (server-to-server only)
# ---------------------------------------------------------------------------
# Private ingestion API URL reachable only by the app API over the VM private
# network, for example https://ingestion-api.internal.example.edu or
# https://10.0.2.4. This is required for the production four-source pipeline. These values are
# server-side runtime settings only and must not be copied into frontend build
# variables or public config payloads.
INGESTION_API_URL=https://<private-akasha-staging-host>
# Deployment secret set in Coolify only. Do not commit a real key or reuse keys
# across staging/production.
INGESTION_API_KEY=CHANGE_ME_INGESTION_API_KEY
INGESTION_REQUEST_TIMEOUT_SECONDS=30
# All four production sources use standalone ingestion for field analytics.
INGESTION_FIELD_INDEX_ENABLED=true
INGESTION_FIELD_INDEX_SOURCE_ID=sentinel-2-l2a
INGESTION_RESOURCESAT_CUTOVER_ENABLED=true
INGESTION_RESOURCESAT_CUTOVER_SOURCE_IDS=resourcesat-2a-liss3-boa,resourcesat-2a-liss4-mx70-l2,resourcesat-2a-awifs-boa
INGESTION_READINESS_ENABLED=true
# Enable both only after EOS-04 package/scale validation and staging tile smoke pass.
INGESTION_EOS04_CUTOVER_ENABLED=false
EOS04_PRODUCT_ENABLED=false
EOS04_FIELD_SUPPORT_ENABLED=false
# Keep all NISAR gates false until the real-product staging acceptance gates pass.
INGESTION_NISAR_CUTOVER_ENABLED=false
NISAR_PRODUCT_ENABLED=false
NISAR_FIELD_SUPPORT_ENABLED=false
# Keep Landsat fail-closed until a real C2 L2 scene passes staging acceptance.
INGESTION_LANDSAT_CUTOVER_ENABLED=false
LANDSAT_PRODUCT_ENABLED=false
LANDSAT_BEST_OPTICAL_ENABLED=false
EOS04_TEMPORAL_CHANGE_ENABLED=false
EOS04_TEMPORAL_SHADOW_ENABLED=false
EOS04_TEMPORAL_RECOMMENDATIONS_ENABLED=false
EOS04_TEMPORAL_LOOKBACK_DAYS=180
EOS04_TEMPORAL_MAX_OBSERVATIONS=8
EOS04_TEMPORAL_MIN_BASELINE_OBSERVATIONS=5
# Optional app-side freshness guard. Leave blank to rely on ingestion readiness.
INGESTION_FRESHNESS_MAX_AGE_HOURS=
INGESTION_AOI_ID=bangalore_60km_geodesic_aoi
INGESTION_SIGNED_URL_ALLOWED_PREFIX=
INGESTION_SIGNED_URL_FETCH_PREFIX=
INGESTION_TREND_MAX_DATES=12
# App-domain pipeline tile layer remains disabled for the app-only stack unless
# a cross-VM tile proxy is explicitly validated later.
INGESTION_PIPELINE_TILE_LAYER_ENABLED=false

# ---------------------------------------------------------------------------
# Admin ingestion console and manual live sync
# ---------------------------------------------------------------------------
# App-only deployments do not run provider downloads or dispatch ingestion jobs.
# Keep false unless a cross-VM inbox handoff is implemented and validated.
ADMIN_INGESTION_LIVE_TRIGGER_ENABLED=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_MODE=enabled
AUTH_ALLOW_DISABLED=false
# Generate a strong random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_PASSWORD_PEPPER=CHANGE_ME_AUTH_PASSWORD_PEPPER
# Self-service signup is closed by default for hosted deployments. Set true only
# when you intentionally want public/team onboarding via /signup.
AUTH_ALLOW_SIGNUP=false
# true requires HTTPS. For temporary public-IP HTTP staging rehearsal only, set false.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_NAME=akasha_session
AUTH_SESSION_TTL_MINUTES=480
AUTH_REMEMBER_TTL_DAYS=30
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_SIGNUP_RATE_LIMIT_PER_HOUR=20
