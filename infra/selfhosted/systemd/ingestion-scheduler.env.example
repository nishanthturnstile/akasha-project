# Akasha ingestion scheduler — environment template.
# Copy to /etc/akasha/ingestion-scheduler.env on the staging worker VM.
# Keep this file root-readable only (chmod 600 or 640) — it may include
# provider credentials or approved-runtime flags.
#
# Phase 8 note: the scheduler timer is DISABLED by default (see TASK-048).
# Install and then explicitly enable when ready:
#   sudo systemctl enable akasha-ingestion-scheduler.timer
#   sudo systemctl start  akasha-ingestion-scheduler.timer
#
# ROLLBACK: sudo systemctl stop --now akasha-ingestion-scheduler.timer
#           sudo systemctl enable --now <legacy-source-timer>.timer
#   See the ownership matrix below for per-source rollback commands.

# ── Compose file / project ────────────────────────────────────────────────────
# Optional. If unset, the wrapper uses /srv/akasha/coolify-compose.yml when
# present, otherwise the first Coolify-rendered /data/coolify/services/* compose.
# AKASHA_COMPOSE_FILE=/data/coolify/services/<resource-uuid>/docker-compose.yml
# AKASHA_COMPOSE_PROJECT=<compose-project>
AKASHA_SYNC_PULL_POLICY=never

# ── Scheduler activation flags ────────────────────────────────────────────────
# Three flags must all be set to enable a live (non-dry-run) scheduler run.
# The defaults produce plan-only output — safe to install and observe first.

# Set to 'true' to enable schedule-due-sources (still dry-run unless DRY_RUN=false).
AKASHA_SCHEDULER_ACTIVE=false

# Set to 'false' only after canary dry-runs confirm expected source/job decisions.
# Requires AKASHA_SCHEDULER_ACTIVE=true to take effect.
AKASHA_SCHEDULER_DRY_RUN=true

# Set to 'true' to pass --approved-runtime to the worker for staging-only
# providers (Bhoonidhi). Requires AKASHA_SCHEDULER_ACTIVE=true.
# This is the approved-runtime preflight gate from OPS-008.
AKASHA_SCHEDULER_APPROVED_RUNTIME=false

# ── Concurrency / per-run budget ──────────────────────────────────────────────
# Maximum source/AOI pairs dispatched in a single scheduler pass.
# Keep low during initial canary period to limit blast radius.
AKASHA_SCHEDULER_MAX_CONCURRENT_SOURCES=2

# Lookback window for the proposed search window in each scheduler plan.
# Matches worker default (12 days). Increase for backfill runs.
AKASHA_SCHEDULER_WINDOW_DAYS=12

# ── Job artifact and lock directories ─────────────────────────────────────────
# All artifacts must stay under /srv/akasha (staging guardrail OPS-002).
AKASHA_SCHEDULER_BASE_DIR=/srv/akasha/ingestion/scheduler/jobs
AKASHA_SCHEDULER_LOCK_DIR=/srv/akasha/ingestion
AKASHA_SCHEDULER_LEDGER_DB_PATH=/srv/akasha/ingestion/scheduler/job_ledger.db

# ── Canary / source filter ────────────────────────────────────────────────────
# During initial cutover, restrict the scheduler to one source or AOI to verify
# parity with the legacy timer before cutting over the full source list.
# Leave unset to allow the scheduler to evaluate all registered sources.
# AKASHA_SCHEDULER_SOURCE=resourcesat-2a-liss3-boa
# AKASHA_SCHEDULER_AOI=bangalore-60km

# ── I/O priority ─────────────────────────────────────────────────────────────
# Keeps raster-heavy container jobs from starving SSH and the Azure VM Agent.
# Mirror the values used by akasha-ingestion-job-runner.sh.
AKASHA_INGESTION_NICE=10
AKASHA_INGESTION_IONICE_CLASS=2
AKASHA_INGESTION_IONICE_LEVEL=7

# ── Storage paths (shared with legacy sync wrappers) ──────────────────────────
AKASHA_SYNC_RAW_ROOT=/srv/akasha/data/raw/bhoonidhi
AKASHA_SYNC_TEMP_ROOT=/srv/akasha/data/work/bhoonidhi
AKASHA_SYNC_LEDGER_PATH=/srv/akasha/ingestion/ledger.sqlite

# ── Stale-lock TTL ────────────────────────────────────────────────────────────
# Worker locks older than this (seconds) are eligible for reclaim by the
# orchestrator's stale-lock handler. Default 2 hours (7200 s).
# AKASHA_SCHEDULER_LOCK_STALE_TTL_SECONDS=7200

# ── Retention / prune ─────────────────────────────────────────────────────────
# Scheduler job artifact directories are pruned after this many days.
# AKASHA_SCHEDULER_JOB_RETENTION_DAYS=14

# ── Provider-specific knobs ───────────────────────────────────────────────────
# Bhoonidhi (ISRO) — staging-only; requires approved-runtime + whitelisted egress.
# Set credentials in /etc/akasha/bhoonidhi-sync.env or as container secrets.
# The scheduler reads these from the Coolify/Docker environment via the adapter.
# AKASHA_BHOONIDHI_URL=https://bhoonidhi.nrsc.gov.in
# AKASHA_BHOONIDHI_USERNAME=<operator-account>
# AKASHA_BHOONIDHI_PASSWORD=<redacted-in-logs>

# ── Legacy-timer source/AOI ownership matrix ─────────────────────────────────
# Tracks which sources/AOIs are owned by which timer, and rollback commands.
# Update this when cutting over a source from a legacy timer to the scheduler.
#
# sourceId                         aoiId            ownedBy            legacyTimerName                   cutoverDate   rollback
# resourcesat-2a-liss3-boa         bangalore-60km   legacy_timer       akasha-bhoonidhi-sync.timer       —             systemctl enable --now akasha-bhoonidhi-sync.timer
# resourcesat-2a-liss4-mx70-l2     bangalore-60km   legacy_timer       akasha-bhoonidhi-liss4-sync.timer —             systemctl enable --now akasha-bhoonidhi-liss4-sync.timer
# resourcesat-2a-awifs-boa         bangalore-60km   manual_only        (none)                            —             n/a (background/gated only)
#
# Do NOT set ownedBy=scheduler_active for a source until:
#   1. scheduler canary dry-run confirms parity with the legacy timer.
#   2. Legacy timer is disabled: systemctl disable --now <legacy-timer>.timer
#   3. This env file reflects the updated ownedBy and cutoverDate.
# NEVER let the scheduler and a legacy timer own the same source/AOI simultaneously.

# ── Scheduler cutover state (informational) ───────────────────────────────────
# Document the current cutover state for rollback traceability.
# AKASHA_SCHEDULER_CUTOVER_STATE=disabled          # initial install
# AKASHA_SCHEDULER_CUTOVER_STATE=canary_plan_only  # ACTIVE=false, watching plan output
# AKASHA_SCHEDULER_CUTOVER_STATE=canary_dry_run    # ACTIVE=true, DRY_RUN=true, source-filtered
# AKASHA_SCHEDULER_CUTOVER_STATE=production        # ACTIVE=true, DRY_RUN=false, all sources
