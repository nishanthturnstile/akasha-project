    "offset": 0,
    "background_value": 0,
    "nodata_policy": "all-band-background-or-warp-gap",
    "note": "LISS-4 L2 reflectance metadata is provisional until staging radiometry validation."
  },
  "akasha:composite_policy": {
    "aoi_id": "bangalore-60km",
    "grid_crs": "EPSG:32643",
    "window_days": 30,
    "selection_rule": "best-available-valid-pixel-with-recency-tiebreak"
  },
  "akasha:attribution": "ISRO-IRS, ISRO/NRSC, Bhoonidhi",
