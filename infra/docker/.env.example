# Akasha local Docker Compose placeholders.
# Copy to .env for local development and replace CHANGE_ME values before starting.

WEB_PORT=8080
FRONTEND_PORT=5173
PUBLIC_APP_NAME=Akasha
PUBLIC_DEFAULT_AOI_NAME=Bangalore

POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=akasha

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# Frontend build-time basemap settings. Local development defaults to OSM to avoid
# consuming ArcGIS billable basemap usage; set VITE_BASEMAP_PROVIDER=esri only when
# deliberately validating the hosted ArcGIS path.
VITE_BASEMAP_PROVIDER=osm
VITE_ESRI_API_KEY=CHANGE_ME_REFERRER_RESTRICTED_ESRI_KEY
VITE_ESRI_BASEMAP_STYLE=arcgis/imagery
VITE_ESRI_BASEMAP_STYLE_FAMILY=arcgis
VITE_ESRI_BASEMAP_PLACES=none
VITE_ESRI_BASEMAP_SESSION_SECONDS=43200

# BFF runtime billing model returned by /api/config. Local OSM ignores this.
# For deliberate Esri validation, use session first; set tile only after the
# compatible frontend/API code is running.
BASEMAP_PROVIDER=esri
ESRI_BASEMAP_STYLE=arcgis/imagery
ESRI_BASEMAP_STYLE_FAMILY=arcgis
ESRI_BASEMAP_USAGE_MODEL=session
ESRI_BASEMAP_PLACES=none
ESRI_BASEMAP_SESSION_SECONDS=43200

# Authentication (enforced). The pepper is a server-side secret mixed into
# every password hash — generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_PASSWORD_PEPPER=CHANGE_ME_AUTH_PASSWORD_PEPPER
# Local self-service sign-up for development/testing multiple users.
# Keep disabled in hosted/customer deployments unless intentionally opened.
AUTH_ALLOW_SIGNUP=true

# Local remote-ingestion bridge placeholders. Disabled by default; uncomment and
# set a real server-side API key only in your local infra/docker/.env.
# The local Sentinel-first workflow requires DEFAULT_SOURCE_ID=sentinel-2-l2a,
# INGESTION_READINESS_ENABLED=true, and INGESTION_FIELD_INDEX_ENABLED=true
# together with a configured bridge URL/key/prefixes. ResourceSat field analytics
# are ingestion-backed only; if the bridge/tunnel is unavailable, ResourceSat
# requests should report ingestion unavailable instead of reading local app COGs.
# DEFAULT_SOURCE_ID=resourcesat-2a-liss3-boa
# INGESTION_API_URL=http://host.docker.internal:18081
# INGESTION_API_KEY=CHANGE_ME
# INGESTION_REQUEST_TIMEOUT_SECONDS=30
# INGESTION_READINESS_ENABLED=false
# INGESTION_FIELD_INDEX_ENABLED=false
# INGESTION_AOI_ID=bangalore_60km_geodesic_aoi
# INGESTION_SIGNED_URL_ALLOWED_PREFIX=http://10.10.2.4:18080
# INGESTION_SIGNED_URL_FETCH_PREFIX=http://host.docker.internal:18081
# INGESTION_TREND_MAX_DATES=12
# Optional best-effort SSH tunnel. scripts/dev-local.sh starts this tunnel when
# INGESTION_API_URL points at host.docker.internal/localhost; failures are non-fatal.
# INGESTION_SSH_TUNNEL_ENABLED=auto
# INGESTION_SSH_TUNNEL_TARGET=akasha-control
# INGESTION_SSH_TUNNEL_LOCAL_PORT=18081
# INGESTION_SSH_TUNNEL_REMOTE_HOST=10.10.2.4
# INGESTION_SSH_TUNNEL_REMOTE_PORT=18080
# To opt into local Sentinel-2 first, change DEFAULT_SOURCE_ID to sentinel-2-l2a
# and enable both bridge readiness and field-index above.

# API Sentinel-1 VV grayscale dB display stretch.
AKASHA_S1_VV_RESCALE=-25,5

# Optional standalone ingestion analytics bridge for local two-stack smoke.
# Defaults keep native app behavior. Use a private/local ingestion API URL and
# a development API key only; never commit real deployment secrets.
INGESTION_API_URL=
INGESTION_API_KEY=CHANGE_ME_LOCAL_INGESTION_API_KEY
INGESTION_REQUEST_TIMEOUT_SECONDS=30
INGESTION_FIELD_INDEX_ENABLED=false
INGESTION_FIELD_INDEX_SOURCE_ID=sentinel-2-l2a
INGESTION_READINESS_ENABLED=false
INGESTION_EOS04_CUTOVER_ENABLED=false
EOS04_PRODUCT_ENABLED=false
EOS04_FIELD_SUPPORT_ENABLED=false
INGESTION_NISAR_CUTOVER_ENABLED=false
NISAR_PRODUCT_ENABLED=false
NISAR_FIELD_SUPPORT_ENABLED=false
EOS04_TEMPORAL_CHANGE_ENABLED=false
EOS04_TEMPORAL_SHADOW_ENABLED=false
EOS04_TEMPORAL_RECOMMENDATIONS_ENABLED=false
EOS04_TEMPORAL_LOOKBACK_DAYS=180
EOS04_TEMPORAL_MAX_OBSERVATIONS=8
EOS04_TEMPORAL_MIN_BASELINE_OBSERVATIONS=5
INGESTION_FRESHNESS_MAX_AGE_HOURS=
INGESTION_AOI_ID=bangalore_60km_geodesic_aoi

# Sentinel-1 SAR preprocessing runtime knobs. These are not secrets.
# The SAR prep service reuses AKASHA_S1_VV_RESCALE above for VV manifest defaults.
SNAP_CACHE_SIZE=8G
SNAP_PARALLELISM=4
SNAP_JAVA_MAX_HEAP=12g
AKASHA_S1_DEM_SOURCE=Copernicus 30m Global DEM
AKASHA_S1_FALLBACK_DEM_SOURCE=SRTM 1Sec HGT
AKASHA_S1_TARGET_CRS=EPSG:4326
AKASHA_S1_PIXEL_SPACING_METERS=10
AKASHA_S1_VH_RESCALE=-30,-5
