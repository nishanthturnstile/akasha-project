[Unit]
Description=Akasha Bhoonidhi ResourceSat LISS-4 sync and composite refresh
Documentation=file:/srv/akasha/docs/impl-plan/feature-resourcesat-liss4-best-resolution-1.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/akasha/bhoonidhi-liss4-sync.env
WorkingDirectory=/srv/akasha
ExecStartPre=/usr/bin/mkdir -p /srv/akasha/ingestion /srv/akasha/data/raw/bhoonidhi /srv/akasha/data/work/bhoonidhi
ExecStart=/usr/bin/flock -n /srv/akasha/ingestion/bhoonidhi-liss4-sync.systemd.lock /bin/bash /opt/akasha/bin/akasha-bhoonidhi-liss4-sync.sh
TimeoutStartSec=6h
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
