# Akasha web gateway — the only public Railway service.

PORT=80
PUBLIC_APP_NAME=Akasha
PUBLIC_DEFAULT_AOI_NAME=Bangalore

# Railway private service URLs.
API_UPSTREAM_URL=http://api.railway.internal:8000
TITILER_UPSTREAM_URL=http://titiler.railway.internal:8000

# Build-time frontend placeholder; set in Railway for the web build when map UX lands.
VITE_BASEMAP_STYLE_URL=<operator-provided MapLibre style URL>

# Empty means off. For a public demo, replace with an edge/auth solution or bcrypt-backed Caddy basic_auth config.
GATEWAY_BASIC_AUTH=