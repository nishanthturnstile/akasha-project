      "fontSize": 14,
      "fontFamily": 6,
      "text": "MinIO (S3 compactable strage)—  /var/lib/geo/\n(Replaces object storage at MVP scale)\n\nraw/  (downloaded scenes)        cog/  (transcoded COGs)\nderived/  (NDVI / NDWI / SAR)   basemap/  (SOI cache)\nuploads/  (reserved: drone/soil)  pg/  (DB volume)",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "RWqgqkAIO3LzNiUMODvsX",
      "originalText": "MinIO (S3 compactable strage)—  /var/lib/geo/\n(Replaces object storage at MVP scale)\n\nraw/  (downloaded scenes)        cog/  (transcoded COGs)\nderived/  (NDVI / NDWI / SAR)   basemap/  (SOI cache)\nuploads/  (reserved: drone/soil)  pg/  (DB volume)",
      "lineHeight": 1.35,
      "index": "aT",
      "autoResize": true
    },
