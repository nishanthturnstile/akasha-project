      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 6,
      "text": "NGINX — EDGE PROXY\nTLS termination, serves the React SPA, reverse-proxies /api, /stac, /tiles, caches map tiles.\nProvides: one secure front door + fast tile delivery via proxy_cache.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "HTZJKprqNBS7P6Bkq49cv",
      "originalText": "NGINX — EDGE PROXY\nTLS termination, serves the React SPA, reverse-proxies /api, /stac, /tiles, caches map tiles.\nProvides: one secure front door + fast tile delivery via proxy_cache.",
      "lineHeight": 1.35,
      "index": "b03",
      "autoResize": true
    },
