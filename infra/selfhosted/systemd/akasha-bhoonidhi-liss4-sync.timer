[Unit]
Description=Every-five-days Akasha Bhoonidhi ResourceSat LISS-4 sync
Documentation=docs/impl-plan/feature-resourcesat-liss4-best-resolution-1.md

[Timer]
OnCalendar=*-*-1/5 03:30:00
RandomizedDelaySec=30m
Persistent=true
Unit=akasha-bhoonidhi-liss4-sync.service

[Install]
WantedBy=timers.target

